<!-- 頁面主要內容區塊 -->
  <main class="page-content">
    
    <!-- 頁首主視覺 Banner -->
    <section class="gov-hero-banner">
      <div class="container text-center">
        <span class="section-tag banner-tag">GOVERNMENT PROJECTS</span>
        <h1 class="banner-title">政府低碳化與智慧化輔導專案對接</h1>
        <p class="banner-desc">
          善用政府補助與轉型資源，艾城市具備豐富政府專案執行經驗，協助產業取得研發補助、低碳升級與人才培訓支持。
        </p>
      </div>
    </section>

    <!-- 政府資源對接優勢 -->
    <section class="section-block section-gov-advantages">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-tag">WHY CHOOSE US</span>
          <h2 class="section-title">政府專案申請與執行全方位支持</h2>
          <p class="section-desc">從計畫書撰寫、審查簡報輔導到結案驗收查核，全程專業陪跑</p>
        </div>

        <div class="advantages-grid">
          <div class="adv-card">
            <h3 class="adv-title">1. 資格與主題精準媒合</h3>
            <p class="adv-text">依據企業所屬產業、營運規模與轉型需求，媒合最高效益之中央與地方政府補助計畫。</p>
          </div>
          <div class="adv-card">
            <h3 class="adv-title">2. 計畫書撰寫與架構優化</h3>
            <p class="adv-text">結合多年輔導經驗，強化計畫之創新性、減碳量化指標與智慧化技術深度，大幅提升過案率。</p>
          </div>
          <div class="adv-card">
            <h3 class="adv-title">3. 結案核銷與合規輔導</h3>
            <p class="adv-text">協助建立標準化經費核銷單據與成果報告書，確保專案執行完全符合政府查驗規範。</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 重點政府補助與專案類別 -->
    <section class="section-block section-gov-categories">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">PROJECT CATEGORIES</span>
          <h2 class="section-title">重點輔導政府專案類別</h2>
          <p class="section-desc">掌握經濟部產業發展署、中小企業署等最新政府計畫資訊</p>
        </div>

        <div class="categories-grid">
          <!-- 專案 1 -->
          <div class="category-card">
            <div class="cat-num-icon cat-green">01</div>
            <h3 class="category-title">中小型製造業低碳化轉型專案</h3>
            <p class="category-desc">
              針對製造業碳盤查（ISO 14064-1）與產品碳足跡（ISO 14067），提供診斷與輔導補助，引導導入節能低碳製程設備與改善方案。
            </p>
            <ul class="category-features">
              <li>碳盤查初階診斷與實地訪視</li>
              <li>低碳化技術升級與設備補助對接</li>
              <li>碳排放量基準建立與減量評估</li>
            </ul>
          </div>

          <!-- 專案 2 -->
          <div class="category-card">
            <div class="cat-num-icon cat-blue">02</div>
            <h3 class="category-title">製造業智慧化升級與 AI 導入</h3>
            <p class="category-desc">
              結合 AI 演算法與 IoT 數據收集，優化生產排程、能源管理（EMS）與設備預診斷，輔導爭取智慧製造專案資源。
            </p>
            <ul class="category-features">
              <li>智慧化成熟度診斷評估</li>
              <li>AI 數據分析與流程自動化導入</li>
              <li>智慧製造專案申請與查核配合</li>
            </ul>
          </div>

          <!-- 專案 3 -->
          <div class="category-card">
            <div class="cat-num-icon cat-gold">03</div>
            <h3 class="category-title">綠領人才在職培訓與補助</h3>
            <p class="category-desc">
              配合政府 iPAS 能力鑑定認證推廣，協助企業運用培訓補助資源，全額或高額補貼員工考取淨零碳管理與 AI 應用證照。
            </p>
            <ul class="category-features">
              <li>iPAS 淨零碳規劃管理師專班</li>
              <li>企業專屬到廠包班培訓</li>
              <li>勞工在職進修與培訓補助對接</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 政府專案最新活動與說明會專區 -->
    <section class="section-block section-gov-events">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">GOV EVENTS</span>
          <h2 class="section-title">政府專案宣導與最新補助說明會</h2>
          <p class="section-desc">即時獲取最新補助梯次開放公告與政策指引說明</p>
        </div>

        <div class="gov-events-grid">
          <div class="gov-event-card">
            <div class="gov-event-header">
              <span class="gov-badge-green">補助說明會</span>
              <span class="gov-event-time">2026.09.22 ｜ 實體+線上同步</span>
            </div>
            <h3 class="gov-event-title">2026 下半年度「中小型製造業低碳智慧雙軸轉型補助」提案準備會</h3>
            <p class="gov-event-desc">針對計畫審查重點、節能指標計算標準與查核要點進行全面拆解，現場開放 1 對 1 資格審視。</p>
            <a href="/Reserve" class="gov-event-link">預約活動席位 →</a>
          </div>

          <div class="gov-event-card">
            <div class="gov-event-header">
              <span class="gov-badge-gold">政策講座</span>
              <span class="gov-event-time">2026.10.05 ｜ 台中實體研討</span>
            </div>
            <h3 class="gov-event-title">碳費徵收機制與企業因應：政府輔導資源最大化運用</h3>
            <p class="gov-event-desc">邀請專家分析碳費上路對中部產業鏈之影響，並介紹如何透過公部門資源進行碳資產盤點與節能改善。</p>
            <a href="/Reserve" class="gov-event-link">預約活動席位 →</a>
          </div>
        </div>
      </div>
