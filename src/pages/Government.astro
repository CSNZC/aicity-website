        </div>
        </section>

        <!-- 公告列表區塊 -->
        <section class="section-block">
        <div class="container">
            <!-- 專案公告卡片列表 -->
            <section class="gov-grid" aria-label="政府最新專案列表">
            {sortedProjects.map((item) => {
                const { title, date, summary, tag, image, id } = item;
                // 點擊後跳轉到對應的詳細頁面路徑
                const postSlug = `/Government/${id}`;

                return (
                <article class="gov-card">
                    <a href={postSlug} class="gov-card-image-wrap">
                    <img src={image || '/img/logo_L.png'} alt={title} class="gov-card-img" loading="lazy" />
                    <span class="gov-tag">{tag}</span>
                    </a>
                    <div class="gov-card-body">
                    <div class="gov-meta">
                        <time datetime={new Date(date).toISOString()}>{formatDate(date)}</time>
                    </div>
                    <h3 class="gov-card-title">
                        <a href={postSlug}>{title}</a>
                    </h3>
                    <p class="gov-card-desc">{summary}</p>
                    <a href={postSlug} class="gov-read-more">
                        查看詳細公告 
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                        </svg>
                    </a>
                    </div>
                </article>
                );
            })}
