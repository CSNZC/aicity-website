---
// 政府最新專案公告清單（純前端陣列，不串後台）
const projectsList = [
  {
    id: "gov-announcement-01",
    title: "115年度經濟部中小企業淨零轉型補助計畫正式公告與申請辦法",
    date: new Date("2026-08-15"),
    image: "/img/logo_L.png",
    tag: "限時申辦",
    summary: "經濟部為協助中小企業因應碳費與國際減碳趨勢，即日起開放年度淨零輔導補助申請，請符合資格之企業把握時效。",
    content: "詳細內文：本計畫旨在協助製造業導入溫室氣體盤查及低碳製程改善..."
  },
  {
    id: "gov-announcement-02",
    title: "農業部 115 年度永續農業暨碳匯場域示範推動計畫徵件說明",
    date: new Date("2026-08-10"),
    image: "/img/logo_L.png",
    tag: "最新公告",
    summary: "農業部最新發布之碳匯場域示範推動專案，廣邀相關農企業與研究機構參與投件，總補助額度有限。",
    content: "詳細內文：為提升國內農業碳匯計量與查證能力，本期開放示範場域申請..."
  },
  {
    id: "gov-announcement-03",
    title: "環境部氣候變遷署「碳盤查與減碳路徑規劃」諮詢窗口服務升級通知",
    date: new Date("2026-08-01"),
    image: "/img/logo_L.png",
    tag: "政策快訊",
    summary: "配合最新法規修正，環境部針對各產業溫室氣體盤查登錄系統推出優化版本，並公布相關輔導說明會日程。",
    content: "詳細內文：為協助產業界順利對接國家減碳目標，氣候變遷署特開設專屬諮詢通道..."
  }
];

// 依發布日期排序 (新 -> 舊)
const sortedProjects = projectsList.sort(
  (a, b) => b.date.getTime() - a.date.getTime()
);

// 日期格式化
const formatDate = (date: Date) => {
  const d = new Date(date);
  return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
};
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>政府最新專案公告 | 艾城市有限公司</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
  
  <!-- 引入拆分出來的獨立 CSS -->
  <link rel="stylesheet" href="/css/Government.css">
</head>
<body>

  <!-- 主要內容區 -->
  <main class="page-content">
    
    <!-- 頁首主視覺 Banner -->
    <section class="gov-hero-banner text-center">
      <div class="container">
        <span class="banner-tag">GOVERNMENT ANNOUNCEMENTS</span>
        <h1 class="banner-title">政府最新專案公告</h1>
        <p class="banner-desc">即時掌握中央與地方政府各項補助、輔導計畫與政策招標最新動態，協助企業搶先佈局永續商機。</p>
      </div>
    </section>

    <!-- 公告列表區塊 -->
    <section class="section-block">
      <div class="container">
        <!-- 專案公告卡片列表 -->
        <section class="gov-grid" aria-label="政府最新專案列表">
          {sortedProjects.map((item) => {
            const { title, date, summary, tag, image, id } = item;
            // 點擊後跳轉到對應的詳細頁面路徑
            const postSlug = `/Government/${id}`;

            return (
              <article class="gov-card">
                <a href={postSlug} class="gov-card-image-wrap">
                  <img src={image || '/img/logo_L.png'} alt={title} class="gov-card-img" loading="lazy" />
                  <span class="gov-tag">{tag}</span>
                </a>
                <div class="gov-card-body">
                  <div class="gov-meta">
                    <time datetime={new Date(date).toISOString()}>{formatDate(date)}</time>
                  </div>
                  <h3 class="gov-card-title">
                    <a href={postSlug}>{title}</a>
                  </h3>
                  <p class="gov-card-desc">{summary}</p>
                  <a href={postSlug} class="gov-read-more">
                    查看詳細公告 
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                  </a>
                </div>
              </article>
            );
          })}
        </section>

      </div>
    </section>

  </main>

</body>
</html>