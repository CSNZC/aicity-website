---
// 這就像是您的 PHP 引入資料庫檔案，直接去讀取 CMS 產生的內容資料夾
import { getCollection, type CollectionEntry } from 'astro:content';
const allPosts: CollectionEntry<'news'>[] = await getCollection('news');

// 假設你的輪播圖資料存放在名為 'hero' 或其他 collection 中
const carouselSlides: CollectionEntry<'carousel'>[] = await getCollection('carousel');
---
<!DOCTYPE html>
<html lang="zh-TW" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>艾城市有限公司</title>

  <!--網站字體-->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@700&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/Aicity.css">
  <link rel="stylesheet" href="/css/style.css">

</head>
<body>
<!--上方導覽列-->
  <header class="navbar-header">
    <div class="nav-container">
      <a href="/" class="logo-link">
        <img src="/img/logo_L.png" alt="艾城市 Logo" class="logo-img">
      </a>
            <nav class="desktop-nav">
                <div class="nav-dropdown">
                    <a href="/Introduction" class="nav-link">關於我們 ▾</a>
                    <div class="dropdown-menu">
                        <a href="/Introduction">公司介紹</a>
                        <a href="/Partners">團隊介紹</a>
                        <a href="/Links">相關連結</a>
                    </div>
                </div>
                <div class="nav-dropdown">
                    <a href="/News" class="nav-link">最新消息</a>
                </div>
                <div class="nav-dropdown">
                    <a href="/Service" class="nav-link">永續服務 ▾</a>
                    <div class="dropdown-menu">
                        <a href="/Business">企業輔導</a>
                        <a href="/Government">政府專案</a>
                    </div>
                </div>
                <div class="nav-dropdown">
                    <a href="/Training" class="nav-link">人員培訓 ▾</a>
                    <div class="dropdown-menu">
                        <a href="/iPAS">iPAS 課程培訓</a>
                        <a href="/ISO">ISO 國際課程培訓</a>
                        <a href="/Courses">永續課程</a>
                    </div>
                </div>
                <div class="nav-dropdown">
                    <a href="/Solar energy" class="nav-link">光電建置</a>
                </div>
                <div class="nav-dropdown">
                    <a href="/Performance  Results" class="nav-link">實績事例 ▾</a>
                    <div class="dropdown-menu">
                        <a href="/PR-S">永續轉型</a>
                        <a href="/PR-T">人員培訓</a>
                        <a href="/PR-E">光電建置</a>
                    </div>
                </div>
                <a href="/Reserve" class="btn-primary-cta">預約健檢</a>
            </nav>

            <button id="mobile-menu-btn" class="mobile-menu-btn" aria-label="開關選單">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="4" y1="6" x2="20" y2="6"></line>
                    <line x1="4" y1="12" x2="20" y2="12"></line>
                    <line x1="4" y1="18" x2="20" y2="18"></line>
                </svg>
            </button>
        </div>
        <!-- 手機版下拉選單 -->
        <div id="mobile-menu" class="mobile-menu">
            <!-- 關於我們 -->
            <div class="mobile-dropdown-group">
                <a href="/Company" class="mobile-link">關於我們 ▾</a>
                <div class="mobile-sub-menu">
                    <a href="/Company" class="mobile-sub-link">公司介紹</a>
                    <a href="/Partners" class="mobile-sub-link">團隊介紹</a>
                    <a href="/Links" class="mobile-sub-link">相關連結</a>
                </div>
            </div>

            <!-- 最新消息 -->
            <a href="/News" class="mobile-link">最新消息</a>

            <!-- 永續服務 -->
            <div class="mobile-dropdown-group">
                <a href="/Service" class="mobile-link">永續服務 ▾</a>
                <div class="mobile-sub-menu">
                    <a href="/Business" class="mobile-sub-link">企業輔導</a>
                    <a href="/Government" class="mobile-sub-link">政府專案</a>
                </div>
            </div>

            <!-- 人員培訓 -->
            <div class="mobile-dropdown-group">
                <a href="/Training" class="mobile-link">人員培訓 ▾</a>
                <div class="mobile-sub-menu">
                    <a href="/iPAS" class="mobile-sub-link">iPAS 課程培訓</a>
                    <a href="/ISO" class="mobile-sub-link">ISO 國際課程培訓</a>
                    <a href="/Courses" class="mobile-sub-link">永續課程</a>
                </div>
            </div>

            <!-- 光電建置 -->
            <a href="/Solar energy" class="mobile-link">光電建置</a>

            <!-- 實績事例 -->
            <div class="mobile-dropdown-group">
                <a href="/Performance  Results" class="mobile-link">實績事例 ▾</a>
                <div class="mobile-sub-menu">
                    <a href="/PR-S" class="mobile-sub-link">永續轉型</a>
                    <a href="/PR-T" class="mobile-sub-link">人員培訓</a>
                    <a href="/PR-E" class="mobile-sub-link">光電建置</a>
                </div>
            </div>

            <!-- 預約健檢 CTA 按鈕 -->
            <a href="/Reserve" class="btn-primary-cta mobile-cta">預約健檢</a>
        </div>
  </header>

<!--區塊輪播圖-->
<section id="home" class="hero-section">
  <div class="carousel-container">
    <div class="carousel-track" id="carousel-track">
      {carouselSlides.map((slide, index) => (
        <div class={`carousel-slide ${index === 0 ? 'active' : ''}`}>
          {slide.data.link ? (
            <a href={slide.data.link}>
              <img src={slide.data.image} alt={slide.data.title} />
            </a>
          ) : (
            <img src={slide.data.image} alt={slide.data.title} />
          )}
        </div>
      ))}
    </div>

    <button class="carousel-btn prev-btn" id="prev-btn" aria-label="上一張">❮</button>
    <button class="carousel-btn next-btn" id="next-btn" aria-label="下一張">❯</button>

    <div class="carousel-dots" id="carousel-dots">
      {carouselSlides.map((_, index) => (
        <span class={`dot ${index === 0 ? 'active' : ''}`} data-slide={index}></span>
      ))}
    </div>
  </div>
</section>

<!--跑馬燈-->
  <section class="ticker-section">
      <div class="ticker-badge">最新消息</div>
      <div class="ticker-wrapper">
        <div id="ticker-track" class="ticker-track">
        </div>
      </div>
    </section>

<!--企業痛點-->
  <section class="content-section bg-light-gray pain-section">
    <div class="section-container">
      <div class="pain-split-grid">
        <div class="pain-left-header">
          <span class="section-subtitle">TRANSFORMATION CHALLENGES</span>
          <h2 class="section-title">您的企業是否面臨以下轉型挑戰？</h2>
          <p class="pain-lead-text">面對日益嚴格的法規要求與供應鏈審查，我們提供一站式專業輔導，協助您打破減碳與數位轉型的盲點。</p>
        </div>

        <div class="pain-right-list">
          <div class="pain-item-card">
            <div class="pain-card-header">
              <span class="pain-tag tag-amber">合規與供應鏈</span>
              <h3 class="pain-item-title">法規與品牌要求雙重壓力？</h3>
            </div>
            <p class="pain-item-desc">不知如何開始 ISO 14064-1 組織碳盤查與 ISO 14067 產品碳足跡計算，面臨國際品牌供應鏈抽查危機。</p>
          </div>

          <div class="pain-item-card">
            <div class="pain-card-header">
              <span class="pain-tag tag-blue">數據管理</span>
              <h3 class="pain-item-title">數據收集繁瑣低效？</h3>
            </div>
            <p class="pain-item-desc">跨部門 Excel 整理耗時易錯，缺乏自動化整合工具（如 EI Bot）與 AI 客服輔助串接。</p>
          </div>

          <div class="pain-item-card">
            <div class="pain-card-header">
              <span class="pain-tag tag-green">資金補助</span>
              <h3 class="pain-item-title">轉型資金與資源不足？</h3>
            </div>
            <p class="pain-item-desc">想引進低碳與智慧化設備，卻不熟悉政府升級轉型補助（16+4 / 19+1）之申請與企劃流程。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

<!--服務項目-->
  <section id="services" class="content-section">
    <div class="section-container">
      <div class="section-header text-center">
        <span class="section-subtitle">OUR CORE SERVICES</span>
        <h2 class="section-title">艾城市核心服務項目</h2>
      </div>

      <div class="services-staggered-list">
        <div class="service-row-card step-1">
          <div class="service-num-badge ">01</div>
          <div class="service-content">
            <h3 class="service-title">永續轉型服務</h3>
            <p> 溫室氣體盤查 | 碳足跡計算 | 永續報告書 | ESG永續轉型 | AI轉型輔導 </p>
          </div>
        </div>

        <div class="service-row-card step-2">
          <div class="service-num-badge gold-badge">02</div>
          <div class="service-content">
            <h3 class="service-title">人員培訓課程</h3>
            <p> iPAS 淨零碳規劃管理師培訓 | 國際認證 ISO 證照課程 | 永續相關課程 </p>
          </div>
        </div>

        <div class="service-row-card step-3">
          <div class="service-num-badge blue-badge">03</div>
          <div class="service-content">
            <h3 class="service-title">綠能光電建置</h3>
            <p> 場域規劃設計 | 工程承攬 | 運營維護服務 </p>
          </div>
        </div>
      </div>
    </div>
  </section>

<!--公司實績-->
  <section id="cases" class="content-section bg-light-gray">
    <div class="section-container">
      <div class="section-header text-center">
        <span class="section-subtitle">Performance & Results</span>
        <h2 class="section-title">公司實績與輔導成果</h2>
      </div>
      <div class="stats-boxes-grid">
        <div class="stat-box-card">
          <div class="stat-number text-emerald">100+</div>
          <div class="stat-title">永續輔導實績</div>
          <p class="stat-desc">協助各類場域完成能源資產盤點與減碳路徑規劃</p>
        </div>
        <div class="stat-box-card">
          <div class="stat-number text-amber">500+</div>
          <div class="stat-title">培訓學員人次</div>
          <p class="stat-desc">舉辦iPAS淨零碳規劃管理師等課程，培育企業核心人才</p>
        </div>
        <div class="stat-box-card">
          <div class="stat-number text-blue">50+</div>
          <div class="stat-title">光電建置場域</div>
          <p class="stat-desc">提供太陽能規劃及工程建置，協助辦理再生能源憑證</p>
        </div>
      </div>
    </div>
  </section>

<!--最新消息-->
<section id="news" class="content-section">
  <div class="section-container">
    <div class="section-header flex-header">
      <div>
        <span class="section-subtitle">LATEST ANNOUNCEMENTS</span>
        <h2 class="section-title">最新消息與熱門課程</h2>
      </div>
      <a class="btn-more-info">更多資訊 ➔</a>
    </div>
    <div class="news-grid-6">
      {allPosts.map((news) => (
        <article class="news-card">
          <div class="news-card-meta">
          <span class="news-tag tag-green">{news.data.tags}</span>
          <span class="news-date">
            {(() => {
              const d = new Date(news.data.date);
              return `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, '0')}/${String(d.getDate()).padStart(2, '0')}`;
            })()}
          </span>
          </div>
          <h3 class="news-card-title">
            <a href={`/news/${news.id}`}>{news.data.title}</a>
          </h3>
          <p class="news-card-summary">{news.data.summary}</p>
        </article>
      ))}
    </div>
    <div class="text-center mobile-more-btn-wrap">
      <a class="btn-more-info">更多資訊 ➔</a>
    </div>
  </div>
</section>

<!--聯絡表單-->
  <section id="contact" class="consult-section">
    <div class="consult-container">
      <div class="section-header text-center">
        <h2 class="consult-title">立即與我們連絡</h2>
        <p class="consult-subtitle">填寫下方資訊，艾城市專業顧問團隊將於 24 小時內與您聯繫</p>
      </div>

      <form class="consult-form-card">
        <div class="form-row-2">
          <div class="form-group">
            <label class="form-label">姓名 *</label>
            <input type="text" required class="form-input" placeholder="請輸入姓名">
          </div>
          <div class="form-group">
            <label class="form-label">公司名稱 *</label>
            <input type="text" required class="form-input" placeholder="請輸入公司名稱">
          </div>
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label class="form-label">聯絡電話 *</label>
            <input type="tel" required class="form-input" placeholder="0912-345-678">
          </div>
          <div class="form-group">
            <label class="form-label">電子郵件 *</label>
            <input type="email" required class="form-input" placeholder="service@company.com">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">諮詢需求領域 (可多選)</label>
          <div class="checkbox-options-grid">
            <label class="checkbox-option">
              <input type="checkbox" name="service" value="永續轉型服務">
              <span>永續轉型</span>
            </label>
            <label class="checkbox-option">
              <input type="checkbox" name="service" value="人員培訓">
              <span>人員培訓</span>
            </label>
            <label class="checkbox-option">
              <input type="checkbox" name="service" value="光電建置">
              <span>光電建置</span>
            </label>
          </div>
          <div class="other-input-wrap">
            <label class="checkbox-option other-label">
              <input type="checkbox" name="service" value="其他">
              <span>其他：</span>
            </label>
            <input type="text" class="form-input other-text-input" placeholder="請簡述您的其他特殊需求...">
          </div>
        </div>
        <button type="submit" class="btn-submit-form">送出</button>
      </form>
    </div>
  </section>

<!--下方導覽列-->
  <footer class="site-footer">
    <div class="footer-compact-container">
      <!--公司介紹-->
      <div class="footer-col footer-col-info">
        <h3 class="footer-company-name">艾城市有限公司</h3>
        <p class="footer-info-text"><strong>電話：</strong>04-23763215 ｜ <strong>傳真：</strong>04-23763213</p>
        <p class="footer-info-text"><strong>Email：</strong>aicitybusiness@gmail.com</p>
        <p class="footer-info-text"><strong>地址：</strong>台中市西區五權五街151號A棟5樓1-2室</p>
      </div>
      <!--快速連結-->
      <div class="footer-col footer-col-links">
        <h4 class="footer-title">快速連結</h4>
        <div class="footer-links-2cols">
          <span>關於我們</span>
          <span>最新消息</span>
          <span>實績事例</span>
          <span>永續服務</span>
          <span>人員培訓</span>
          <span>光電建置</span>
        </div>
      </div>
      <!--社群QR-->
      <div class="footer-col footer-col-social">
        <h4 class="footer-title">官方社群</h4>
        <div class="qr-code-group">
          <div class="qr-code-item">
            <img src="/img/FB.png" alt="FB QR Code" class="qr-img">
            <span>Facebook</span>
          </div>
          <div class="qr-code-item">
            <img src="/img/IG.png" alt="IG QR Code" class="qr-img">
            <span>Instagram</span>
          </div>
          <div class="qr-code-item">
            <img src="/img/LINE.png" alt="Line QR Code" class="qr-img">
            <span>LINE 官方</span>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-copyright">
      <p>&copy; 2026 艾城市有限公司 AI City Co., Ltd. All Rights Reserved.</p>
    </div>
  </footer>

  <script src="/js/Aicity.js" defer></script>
  <script src="/js/style.js" defer></script>

</body>
</html>