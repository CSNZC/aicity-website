    <!-- 頁首主視覺 Banner -->
    <section class="business-hero-banner">
      <div class="container text-center">
        <span class="section-tag banner-tag">ENTERPRISE CONSULTING</span>
        <h1 class="banner-title">企業永續轉型與碳管理顧問輔導</h1>
        <p class="banner-desc">
          從組織碳盤查、產品碳足跡到編撰永續報告書，艾城市陪伴企業打造自主盤查能力，落實實質減碳與綠色競爭力。
        </p>
      </div>
    </section>

    <!-- 企業常見痛點解析 -->
    <section class="section-block section-challenges">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-tag">CHALLENGES</span>
          <h2 class="section-title">面對淨零浪潮，您的企業是否面臨這些挑戰？</h2>
          <p class="section-desc">國際供應鏈要求、CBAM 碳邊境稅、金管會 ESG 揭露政策接踵而來</p>
        </div>

        <div class="challenges-grid">
          <div class="challenge-card">
            <h3 class="challenge-title">1. 客戶要求提交碳數據</h3>
            <p class="challenge-text">國際大廠與供應鏈端要求提供 ISO 14064-1 或 ISO 14067 查證數據，內部卻缺乏專業盤查知識與計算能力。</p>
          </div>
          <div class="challenge-card">
            <h3 class="challenge-title">2. 內部數據雜亂缺乏工具</h3>
            <p class="challenge-text">電力、燃油、冷媒及原物料單據散落各廠區部門，缺乏標準化資料收集流程與系統工具，填報耗時費力。</p>
          </div>
          <div class="challenge-card">
            <h3 class="challenge-title">3. 依賴外部顧問無法扎根</h3>
            <p class="challenge-text">每年委外花費高昂，顧問離開後同仁依舊無法獨立維護盤查報告與清冊，無法形成企業內部長期綠領資產。</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 企業輔導四大核心項目 -->
    <section class="section-block section-solutions">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">OUR SOLUTIONS</span>
          <h2 class="section-title">客製化企業輔導核心方案</h2>
          <p class="section-desc">實務導向、系統化導入，確保符合第三方查證與法規要求</p>
        </div>

        <div class="solutions-list">
          <!-- 方案 1 -->
          <div class="solution-card">
            <div class="solution-info">
              <span class="solution-badge">方案一</span>
              <h3 class="solution-name">ISO 14064-1 溫室氣體盤查輔導</h3>
              <p class="solution-desc">建立組織邊界、進行直接與間接排放源鑑別、實施活動數據品質評估與量化計算，輔導完成盤查清冊與內部稽核，協助取得第三方查證機構之查證聲明書。</p>
            </div>
            <div class="solution-deliverables">
              <h4 class="deliverables-title">輔導產出交付物：</h4>
              <ul class="deliverables-list">
                <li>組織溫室氣體盤查清冊（活動數據與排放因子對照）</li>
                <li>溫室氣體盤查報告書（符規 ISO 14064-1:2018）</li>
                <li>內部稽核查檢表與改善建議報告</li>
              </ul>
            </div>
          </div>

          <!-- 方案 2 -->
          <div class="solution-card">
            <div class="solution-info">
              <span class="solution-badge">方案二</span>
              <h3 class="solution-name">ISO 14067 產品碳足跡盤查與碳標籤</h3>
              <p class="solution-desc">針對企業主力產品，評估其生命週期各階段碳排（原物料開採、製造、運輸等），找出碳排熱點並擬定綠色設計與低碳製程策略。</p>
            </div>
            <div class="solution-deliverables">
              <h4 class="deliverables-title">輔導產出交付物：</h4>
              <ul class="deliverables-list">
                <li>產品生命週期流程圖與數據蒐集範本</li>
                <li>ISO 14067 產品碳足跡研究報告書</li>
                <li>產品減碳優化建議與供應鏈溝通報告</li>
              </ul>
            </div>
          </div>

          <!-- 方案 3 -->
          <div class="solution-card">
            <div class="solution-info">
              <span class="solution-badge">方案三</span>
              <h3 class="solution-name">ESG 永續報告書編撰與永續藍圖</h3>
              <p class="solution-desc">以 GRI 通用準則為基底，結合企業永續發展方針，規劃環境 (E)、社會 (S) 與公司治理 (G) 關鍵績效指標與永續策略地圖。</p>
            </div>
            <div class="solution-deliverables">
              <h4 class="deliverables-title">輔導產出交付物：</h4>
              <ul class="deliverables-list">
                <li>利害關係人問卷與重大性主題矩陣分析</li>
                <li>中英文版 ESG 永續報告書完整編排檔案</li>
                <li>永續績效指標（KPIs）追蹤機制手冊</li>
              </ul>
            </div>
          </div>

          <!-- 方案 4 -->
          <div class="solution-card">
            <div class="solution-info">
              <span class="solution-badge">方案四</span>
              <h3 class="solution-name">AI 轉型</h3>
              <p class="solution-desc">結合 IoT 物聯網儀表與 AI 自動化演算法，即時監控工廠動力與空調高耗能設備，提供最佳能源使用調節建議。</p>
            </div>
            <div class="solution-deliverables">
              <h4 class="deliverables-title">輔導產出交付物：</h4>
              <ul class="deliverables-list">
                <li>廠區能耗流向與用電熱點分析報告</li>
                <li>AI 節能控制與製程優化評估建議書</li>
                <li>節能量量測與驗證（M&V）實施報告</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 輔導規劃 (含圖片) -->
    <section class="section-block section-consulting">
        <div class="container">
          <div class="section-header">
            <span class="section-tag">CONSULTING & TRAINING</span>
            <h2 class="section-title">輔導規劃與碳盤查機制建立</h2>
          </div>

          <div class="consulting-wrapper">
            <!-- 核心理念與文字 -->
            <div class="consulting-content">
              <div class="purpose-highlight">
                <h3 class="purpose-title">規劃目的 — 給您魚吃，不如教您釣魚</h3>
                <p class="purpose-desc">
                  隨著國際間對於溫室氣體管理及減排要求日益嚴格，企業唯有建立自主碳盤查能力，方能穩健達成永續經營目標。本企劃依據 <strong>ISO 14064-1:2018 標準</strong>，協助企業建立完善機制，培育內部稽核與盤查關鍵人才。
                </p>
              </div>

              <div class="feature-steps">
                <div class="step-item">
                  <div class="step-num">01</div>
                  <div class="step-info">
                    <h4>全盤掌握企業碳資訊</h4>
                    <p>由專業顧問團隊深入產線與營運環節，精準盤點各項溫室氣體排放源。</p>
                  </div>
                </div>
                <div class="step-item">
                  <div class="step-num">02</div>
                  <div class="step-info">
                    <h4>做中學 ＆ 學中做</h4>
                    <p>輔導過程中投入企業內部人員共同參與，實作演練排放量計算與盤查清冊建置。</p>
                  </div>
                </div>
                <div class="step-item">
                  <div class="step-num">03</div>
                  <div class="step-info">
                    <h4>培育國際證照專業人員</h4>
                    <p>輔導內部同仁具備獨立撰寫盤查報告書、執行內部稽核並考取國際證照之實務能力。</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- 圖片展示區 -->
            <div class="consulting-image-box">
              <div class="image-frame">
                <img src="/img/service.png" alt="ISO 14064-1 企業輔導流程與培育規劃" class="consulting-img">
                <div class="image-caption">
                  <strong>ISO 14064-1 盤查與輔導流程</strong>
                  <span>全方位碳盤查輔導與人才培訓機制</span>
                </div>
              </div>
            </div>
          </div>
        </div>
    </section>

