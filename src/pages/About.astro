---
import { getCollection, type CollectionEntry } from 'astro:content';
import Model from '../layouts/Model.astro';

const aboutItems: CollectionEntry<'about'>[] = await getCollection('about');
aboutItems.sort((a, b) => a.data.weight - b.data.weight);
---

<Model title="公司介紹｜艾城市有限公司" customCss="/css/About.css">
  <!-- 頁面主要內容 -->
  <section class="hero">
    <div class="container hero-content">
      <h1>引領企業邁向 2050 淨零碳排</h1>
      <p>從碳盤查開始，讓企業擁有真正的「碳」實力，實現永續經營目標。</p>
    </div>
  </section>

  <!-- 關於我們時間軸 -->
  <section id="about" class="section">
    <div class="container">
      <h2 class="section-title text-center">艾城市 - 里程碑</h2>
      <div class="timeline-scroll-container">
        <div class="timeline-horizontal">
          <div class="timeline-axis"></div>
          <!-- 項目 1 -->
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-card">
              <div class="timeline-year">2022.05</div>
              <div class="timeline-content">
                <h3>艾城市成立</h3>
                <p>聚焦企業碳管理、人才培育與減排服務。</p>
              </div>
            </div>
          </div>
          <!-- 項目 2 -->
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-card">
              <div class="timeline-year">2023</div>
              <div class="timeline-content">
                <h3>服務版圖擴展</h3>
                <p>從企業碳盤查輔導進一步延伸至低碳轉型與專業人才培訓。</p>
              </div>
            </div>
          </div>
          <!-- 項目 3 -->
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-card">
              <div class="timeline-year">2024</div>
              <div class="timeline-content">
                <h3>深化永續人才培育</h3>
                <p>持續拓展企業內訓、專業證照培訓與永續相關課程。</p>
              </div>
            </div>
          </div>
          <!-- 項目 4 -->
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-card">
              <div class="timeline-year">2025</div>
              <div class="timeline-content">
                <h3>整合減排實務服務</h3>
                <p>將顧問輔導、人才培訓與工程服務進一步整合。</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 核心營運項目 -->
  <section id="services" class="section">
    <div class="container">
      <h2 class="section-title text-center">核心營運項目</h2>
      <p class="section-subtitle text-center">從盤查、減排工程到國際級證照培訓，提供一站式碳管理解決方案</p>
      
      <div class="service-rows">
        <!-- 項目 1 -->
        <div class="service-row-item">
          <div class="service-num-badge">01</div>
          <div class="service-detail">
            <h3>企業輔導服務</h3>
            <p>協助企業進行溫室氣體排放數據量化，並輔導撰寫溫室氣體盤查報告書、計算碳足跡。視企業需求協助建置內部盤查小組或盤查人力，並為其媒合第三方查證/確證機構（合作夥伴包含「艾法諾」及「亞瑞仕」），同步導入 ESG 制度。</p>
            <span class="service-tag">溫室氣體盤查</span>
            <span class="service-tag">碳足跡計算</span>
            <span class="service-tag">永續報告書</span>
            <span class="service-tag">ESG永續轉型</span>
            <span class="service-tag">AI轉型輔導</span>
          </div>
        </div>

        <!-- 項目 2 -->
        <div class="service-row-item">
          <div class="service-num-badge">02</div>
          <div class="service-detail">
            <h3>專業人員培訓</h3>
            <p>開辦 ISO 14064、ISO 14067 等課程，培育專業稽核員/查證師/確證師，為台灣填補綠能產業人才缺口。配合政府推動 iPAS 淨零碳規劃管理師職能證照，讓企業擁有真正的「碳」實力。</p>
            <span class="service-tag">iPAS淨零碳規劃管理師培訓</span>
            <span class="service-tag">國際認證ISO證照課程</span>
            <span class="service-tag">永續相關課程</span>
          </div>
        </div>

        <!-- 項目 3 -->
        <div class="service-row-item">
          <div class="service-num-badge">03</div>
          <div class="service-detail">
            <h3>減排工程服務</h3>
            <p>提供再生能源創能服務之案場開發、場域規劃設計與工程承攬，以及案場運營維護服務。協助進行台電審查、躉售、併網之專案管理服務，並提供節能電器安裝工程與儲能系統規劃。</p>
            <span class="service-tag">場域規劃設計</span>
            <span class="service-tag">工程承攬</span>
            <span class="service-tag">運營維護服務</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 官方認證專區 -->
  <section id="credentials" class="section bg-sand">
    <div class="container">
      <div class="credential-box">
        <h2>官方認證與合作</h2>        
        <div class="credential-list">
          {aboutItems.map((item) => (
            <div class="story-item">
              <div class="story-content">
                <h3>{item.data.title}</h3>
                <p>{item.data.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Model>