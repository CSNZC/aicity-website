---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Model from '../../layouts/Model.astro';

export async function getStaticPaths() {
  const posts: CollectionEntry<'news'>[] = await getCollection('news');
  return posts.map(post => ({
    params: { slug: post.id || (post as any).slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: CollectionEntry<'news'> };
const { Content } = await render(post);

const formatDate = (date: Date) => {
  const d = new Date(date);
  return `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, '0')}/${String(d.getDate()).padStart(2, '0')}`;
};
---

<Model title={`${post.data.title} | 艾城市有限公司`}>
  <!-- 單一主容器，直接控制寬度與邊距 -->
  <div class="article-container">
    
    <!-- 返回按鈕 -->
    <div class="back-nav">
      <a href="/News" class="back-btn">← 返回最新消息</a>
    </div>

    <!-- 內文核心卡片 -->
    <main class="article-main">
      <header class="article-header">
        <div class="article-tag-list">
          {post.data.tags && post.data.tags.map((tag: string) => (
            <span class="article-tag">{tag}</span>
          ))}
          {post.data.event_status && (
            <span class="article-tag article-tag-status">{post.data.event_status}</span>
          )}
        </div>
        <h1 class="article-title">{post.data.title}</h1>
      </header>

      {post.data.image && (
        <div class="article-image-box">
          <img src={post.data.image} alt={post.data.title} class="article-featured-img" />
        </div>
      )}

      <time class="article-meta-time" datetime={new Date(post.data.date).toISOString()}>
        發布日期：{formatDate(post.data.date)}
      </time>

      <article class="article-body-content">
        <Content />
      </article>
    </main>

    <!-- 獨立於內文外的報名表單卡片 -->
    {post.data.enable_registration && (
      <section class="event-reg-section">
        <div class="event-reg-header">
          <h2 class="event-reg-title">線上活動報名</h2>
          <p class="event-reg-subtitle">
            您正在報名：<strong>【{post.data.title}】</strong>，請填寫以下資訊完成報名。
          </p>
        </div>

        <form id="eventRegisterForm" class="event-reg-form">
          <input type="hidden" name="formType" value={`講座報名-${post.data.title}`} />

          <div class="form-row-2">
            <div class="form-group">
              <label class="form-label">報名人姓名 *</label>
              <input type="text" name="name" required class="form-input" placeholder="請輸入姓名" />
            </div>
            <div class="form-group">
              <label class="form-label">公司 / 任職單位 *</label>
              <input type="text" name="company" required class="form-input" placeholder="請輸入公司或單位名稱" />
            </div>
          </div>

          <div class="form-row-2">
            <div class="form-group">
              <label class="form-label">聯絡電話 *</label>
              <input type="tel" name="phone" required class="form-input" placeholder="0912-345-678" />
            </div>
            <div class="form-group">
              <label class="form-label">電子郵件 *</label>
              <input type="email" name="email" required class="form-input" placeholder="service@company.com" />
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">提問或其他備註需求</label>
            <textarea name="message" rows="3" class="form-input form-textarea" placeholder="如有特定想了解的議題或需求，歡迎在此填寫..."></textarea>
          </div>

          <button type="submit" id="eventSubmitBtn" class="btn-reg-submit">
            確認送出報名
          </button>
        </form>
      </section>
    )}

  </div>
</Model>

<style>
  /* 單一頂層容器 */
  .article-container {
    max-width: 860px;
    margin: 0 auto;
    padding: 40px 20px 80px;
  }

  .back-nav {
    margin-bottom: 20px;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--primary-green, #1b5e20);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-btn:hover {
    color: var(--accent-gold, #c5a059);
  }

  /* 文章主體卡片 */
  .article-main {
    background: var(--bg-white, #ffffff);
    border-radius: 12px;
    border: 1px solid var(--border-color, #eaeaea);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    padding: 48px;
    margin-bottom: 32px;
  }

  .article-header {
    margin-bottom: 24px;
  }

  .article-tag-list {
    display: flex;
    gap: 8px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .article-tag {
    background: var(--accent-gold-light, #fdf8eb);
    color: var(--accent-gold, #c5a059);
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 20px;
  }

  .article-tag-status {
    background: var(--bg-light-gray, #f8f9fa);
    color: var(--primary-green, #1b5e20);
    border: 1px solid var(--border-color, #eaeaea);
  }

  .article-title {
    font-family: 'Noto Serif TC', serif;
    font-size: 2.15rem;
    font-weight: 700;
    color: var(--primary-green, #1b5e20);
    line-height: 1.4;
    margin: 0;
  }

  /* 調整圖片容器與自適應圖片設定 */
  .article-image-box {
    width: 100%;
    max-height: 480px;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 24px;
    background-color: var(--bg-light-gray, #f8f9fa);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .article-featured-img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* 保持填滿並自動裁切邊緣以適應各種比例 */
    display: block;
  }

  .article-meta-time {
    font-size: 0.875rem;
    color: var(--text-muted, #757575);
    margin-bottom: 28px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-color, #eaeaea);
    display: block;
  }

  /* 內文排版與分線設計 */
  .article-body-content {
    font-size: 1.0625rem;
    line-height: 1.85;
    color: var(--text-body, #333333);
  }

  .article-body-content p {
    margin-bottom: 1.6em;
  }

  /* 為內文中的標題或段落區塊加入微型分隔線效果 */
  .article-body-content h2,
  .article-body-content h3 {
    color: var(--primary-green, #1b5e20);
    margin-top: 2.2em;
    margin-bottom: 0.8em;
    font-weight: 700;
    padding-bottom: 0.4em;
    border-bottom: 1px dashed var(--border-color, #eaeaea); /* 加上柔和的分隔虛線 */
  }

  .article-body-content ul,
  .article-body-content ol {
    margin-bottom: 1.6em;
    padding-left: 24px;
  }

  .article-body-content li {
    margin-bottom: 8px;
  }

  /* 獨立報名表卡片 */
  .event-reg-section {
    background: var(--bg-white, #ffffff);
    border: 1px solid var(--border-color, #eaeaea);
    border-radius: 12px;
    padding: 40px 48px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  .event-reg-header {
    text-align: center;
    margin-bottom: 28px;
  }

  .event-reg-title {
    font-family: 'Noto Serif TC', serif;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--primary-green, #1b5e20);
    margin-bottom: 8px;
  }

  .event-reg-subtitle {
    font-size: 0.9375rem;
    color: var(--text-muted, #666666);
    line-height: 1.5;
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .form-group {
    margin-bottom: 18px;
  }

  .form-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-dark, #333333);
    margin-bottom: 6px;
  }

  .form-input {
    width: 100%;
    padding: 10px 14px;
    font-size: 0.9375rem;
    border: 1px solid var(--border-color, #dddddd);
    border-radius: 6px;
    background: var(--bg-white, #ffffff);
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-input:focus {
    border-color: var(--primary-green, #1b5e20);
    box-shadow: 0 0 0 3px rgba(27, 94, 32, 0.1);
  }

  .form-textarea {
    resize: vertical;
  }

  .btn-reg-submit {
    width: 100%;
    padding: 13px;
    background: var(--primary-green, #1b5e20);
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .btn-reg-submit:hover {
    background: var(--accent-gold, #c5a059);
  }

  .btn-reg-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* 行動裝置適配 */
  @media (max-width: 768px) {
    .article-container {
      padding: 24px 16px 60px;
    }
    .article-main,
    .event-reg-section {
      padding: 24px 18px;
    }
    .article-title {
      font-size: 1.6rem;
    }
    .article-image-box {
      max-height: 280px; /* 手機版自動降低圖片的最大高度，避免佔用太多畫面 */
    }
    .form-row-2 {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>

<script>
  const GAS_ENDPOINT_URL = 'https://script.google.com/macros/s/AKfycbwmU4dgvNumk8jcLNe1z5JJIxpSTEYR6vyBX3Fo43I_iCrbujLd17SRBpAK74LRbEBH/exec';

  const eventForm = document.getElementById('eventRegisterForm') as HTMLFormElement | null;
  const eventSubmitBtn = document.getElementById('eventSubmitBtn') as HTMLButtonElement | null;

  if (eventForm && eventSubmitBtn) {
    eventForm.addEventListener('submit', async (e: SubmitEvent) => {
      e.preventDefault();

      const getVal = (name: string): string => {
        const el = eventForm.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`);
        return el ? el.value.trim() : '';
      };

      const payload = {
        formType: getVal('formType'),
        name: getVal('name'),
        company: getVal('company'),
        phone: getVal('phone'),
        email: getVal('email'),
        services: getVal('message')
      };

      eventSubmitBtn.disabled = true;
      const originalText = eventSubmitBtn.textContent || '確認送出報名';
      eventSubmitBtn.textContent = '資料送出中...';

      try {
        await fetch(GAS_ENDPOINT_URL, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        alert(`【${payload.formType}】報名成功！我們已收到您的資訊，將儘快與您聯繫。`);
        eventForm.reset();
      } catch (error) {
        console.error('送出失敗:', error);
        alert('送出時發生錯誤，請稍後再試。');
      } finally {
        eventSubmitBtn.disabled = false;
        eventSubmitBtn.textContent = originalText;
      }
    });
  }
</script>