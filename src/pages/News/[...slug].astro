---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Model from '../../layouts/Model.astro'; // 若在 src/pages/News/[slug].astro 退兩層；若在單層退一層 ../layouts/Model.astro

export async function getStaticPaths() {
  const posts: CollectionEntry<'news'>[] = await getCollection('news');
  return posts.map(post => ({
    params: { slug: post.id || (post as any).slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: CollectionEntry<'news'> };
const { Content } = await render(post);

const formatDate = (date: Date) => {
  const d = new Date(date);
  return `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, '0')}/${String(d.getDate()).padStart(2, '0')}`;
};
---

<Model title={`${post.data.title} | 艾城市有限公司`}>
  <main class="article-page">
    <div class="article-wrapper">
      
      <!-- 返回按鈕 -->
      <div class="back-nav">
        <a href="/News" class="back-btn">← 返回最新消息</a>
      </div>

      <!-- 第一塊：標題與標籤 -->
      <header class="article-header">
        <div class="article-tag-list">
          {post.data.tags.map((tag: string) => (
            <span class="article-tag">{tag}</span>
          ))}
        </div>
        <h1 class="article-title">{post.data.title}</h1>
      </header>

      <!-- 接續區塊 1：圖 -->
      {post.data.image && (
        <div class="article-image-box">
          <img src={post.data.image} alt={post.data.title} class="article-featured-img" />
        </div>
      )}

      <!-- 接續區塊 2：時間 (小字) -->
      <time class="article-meta-time" datetime={new Date(post.data.date).toISOString()}>
        發布日期：{formatDate(post.data.date)}
      </time>

      <!-- 接續區塊 3：區段內文 (Markdown 渲染) -->
      <article class="article-body-content">
        <Content />
      </article>

    </div>
  </main>
</Model>

<style>
  .article-page {
    background-color: var(--bg-light-gray);
    min-height: calc(100vh - var(--nav-height));
    padding: 60px 24px 100px;
  }

  .article-wrapper {
    max-width: 860px;
    margin: 0 auto;
    background: var(--bg-white);
    border-radius: 12px;
    border: 1px solid var(--border-color);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    padding: 48px;
  }

  .back-nav {
    margin-bottom: 24px;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--primary-green);
    font-weight: 600;
    font-size: 0.9375rem;
    transition: color 0.2s ease;
  }

  .back-btn:hover {
    color: var(--accent-gold);
  }

  /* 區塊 1：標題與標籤 */
  .article-header {
    margin-bottom: 28px;
  }

  .article-tag-list {
    display: flex;
    gap: 8px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .article-tag {
    background: var(--accent-gold-light);
    color: var(--accent-gold);
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 20px;
  }

  .article-title {
    font-family: 'Noto Serif TC', serif;
    font-size: 2.15rem;
    font-weight: 700;
    color: var(--primary-green);
    line-height: 1.4;
    margin: 0;
  }

  /* 區塊 2：主圖 */
  .article-image-box {
    width: 100%;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 14px;
    background-color: var(--bg-light-gray);
  }

  .article-featured-img {
    width: 100%;
    height: auto;
    max-height: 480px;
    object-fit: cover;
    display: block;
  }

  /* 區塊 3：發布時間 (小字) */
  .article-meta-time {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 32px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-color);
    display: block;
  }

  /* 區塊 4：段落內文 */
  .article-body-content {
    font-size: 1.0625rem;
    line-height: 1.85;
    color: var(--text-body);
  }

  .article-body-content p {
    margin-bottom: 1.6em;
  }

  .article-body-content h2,
  .article-body-content h3 {
    color: var(--primary-green);
    margin-top: 1.8em;
    margin-bottom: 0.8em;
    font-weight: 700;
  }

  .article-body-content ul,
  .article-body-content ol {
    margin-bottom: 1.6em;
    padding-left: 24px;
  }

  .article-body-content li {
    margin-bottom: 8px;
  }

  @media (max-width: 768px) {
    .article-page {
      padding: 30px 16px 60px;
    }
    .article-wrapper {
      padding: 24px 18px;
    }
    .article-title {
      font-size: 1.6rem;
    }
  }
</style>