      <!-- 文章卡片列表 (動態渲染 6 筆) -->
      <section class="news-grid" aria-label="最新消息列表">
        {newsList.map((item) => {
          const { title, date, summary, tags, image } = item.data;
          const firstTag = tags && tags.length > 0 ? tags[0] : '最新消息';
          const postSlug = item.id || (item as any).slug;

          return (
            <article class="news-card" data-tags={JSON.stringify(tags || [])}>
              <a href={`/News/${postSlug}`} class="news-card-image-wrap">
                <img src={image || '/img/logo_L.png'} alt={title} class="news-card-img" loading="lazy" />
                <span class="news-tag">{firstTag}</span>
              </a>
              <div class="news-card-body">
                <div class="news-meta">
                  <time datetime={new Date(date).toISOString()}>{formatDate(date)}</time>
                </div>
                <h2 class="news-card-title">
                  <a href={`/News/${postSlug}`}>{title}</a>
                </h2>
                <p class="news-card-desc">{summary}</p>
                <a href={`/News/${postSlug}`} class="news-read-more">
                  閱讀更多 
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </a>
              </div>
            </article>
          );
        })}
      </section>

      <!-- 動態分頁 -->
      {page.lastPage > 1 && (
        <nav class="news-pagination" aria-label="分頁導覽">
          {page.url.prev ? (
            <a href={page.url.prev} class="page-link prev">‹</a>
          ) : (
            <span class="page-link prev disabled">‹</span>
          )}

          {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((pageNum) => {
            const targetUrl = pageNum === 1 ? '/News' : `/News/${pageNum}`;
            const isCurrent = page.currentPage === pageNum;
            return (
              <a href={targetUrl} class={`page-link ${isCurrent ? 'active' : ''}`}>
                {pageNum}
              </a>
            );
          })}

          {page.url.next ? (
            <a href={page.url.next} class="page-link next">›</a>
          ) : (
            <span class="page-link next disabled">›</span>
          )}
        </nav>
