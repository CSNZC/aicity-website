---
import Model from '../../layouts/Model.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths({ paginate }: any) {
  const allPosts: CollectionEntry<'news'>[] = await getCollection('news');
  
  // 依發布日期排序 (新 -> 舊)
  const sortedPosts = allPosts.sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
  );

  // 每頁 6 筆
  return paginate(sortedPosts, { pageSize: 6 });
}

// 取得當前頁面的資料與分頁狀態
const { page } = Astro.props;
const newsList: CollectionEntry<'news'>[] = page.data;

// 日期格式化
const formatDate = (date: Date) => {
  const d = new Date(date);
  return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
};
---

<Model title="最新消息 | 艾城市有限公司" customCss="/css/News.css">
  <!-- 主要內容區 -->
  <main class="page-content">
    <div class="news-container">
      
      <header class="news-header">
        <div class="header-title-group">
          <span class="section-subtitle">LATEST UPDATES</span>
          <h1 class="page-title">最新消息</h1>
        </div>
        <!-- 分類標籤及搜尋類 -->
        <div class="news-toolbar">
          <div class="category-filters">
            <button class="filter-btn active" data-tag="all">全部</button>
            <button class="filter-btn" data-tag="公司消息">公司消息</button>
            <button class="filter-btn" data-tag="政府政策">政府政策</button>
            <button class="filter-btn" data-tag="課程資訊">課程資訊</button>
            <button class="filter-btn" data-tag="新知分享">新知分享</button>
            <button class="filter-btn" data-tag="其他">其他</button>
          </div>

          <form class="news-search-form" onsubmit="return false;">
            <div class="search-input-wrapper">
              <input type="text" id="news-search" class="search-input" placeholder="搜尋最新消息..." aria-label="搜尋最新消息">
              <button type="button" class="search-submit-btn" aria-label="搜尋">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
              </button>
            </div>
          </form>
        </div>
      </header>

      <!-- 文章卡片列表 -->
      <section class="news-grid" aria-label="最新消息列表">
        {newsList.map((item) => {
          const { title, date, summary, tags, image } = item.data;
          const firstTag = tags && tags.length > 0 ? tags[0] : '最新消息';
          const postSlug = item.id || (item as any).slug;

          return (
            <article class="news-card" data-tags={JSON.stringify(tags || [])}>
              <a href={`/News/${postSlug}`} class="news-card-image-wrap">
                <img src={image || '/img/logo_L.png'} alt={title} class="news-card-img" loading="lazy" />
                <span class="news-tag">{firstTag}</span>
              </a>
              <div class="news-card-body">
                <div class="news-meta">
                  <time datetime={new Date(date).toISOString()}>{formatDate(date)}</time>
                </div>
                <h2 class="news-card-title">
                  <a href={`/News/${postSlug}`}>{title}</a>
                </h2>
                <p class="news-card-desc">{summary}</p>
                <a href={`/News/${postSlug}`} class="news-read-more">
                  閱讀更多 
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </a>
              </div>
            </article>
          );
        })}
      </section>

      <!-- 分頁換頁導覽 -->
      <nav class="news-pagination" aria-label="分頁導覽">
        {/* 上一頁 */}
        {page.url.prev ? (
          <a href={page.url.prev} class="page-link prev" aria-label="上一頁">‹</a>
        ) : (
          <span class="page-link prev disabled">‹</span>
        )}

        {/* 數字頁碼 */}
        {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((pageNum) => {
          const targetUrl = pageNum === 1 ? '/News' : `/News/${pageNum}`;
          const isCurrent = page.currentPage === pageNum;
          return (
            <a href={targetUrl} class={`page-link ${isCurrent ? 'active' : ''}`}>
              {pageNum}
            </a>
          );
        })}

        {/* 下一頁 */}
        {page.url.next ? (
          <a href={page.url.next} class="page-link next" aria-label="下一頁">›</a>
        ) : (
          <span class="page-link next disabled">›</span>
        )}
      </nav>

    </div>
  </main>

  <!-- 篩選與搜尋互動前端腳本 -->
  <script>
    const filterBtns = document.querySelectorAll('.filter-btn');
    const searchInput = document.getElementById('news-search') as HTMLInputElement;
    const cards = document.querySelectorAll('.news-card') as NodeListOf<HTMLElement>;

    function filterCards() {
      const activeBtn = document.querySelector('.filter-btn.active') as HTMLElement;
      const selectedTag = activeBtn?.dataset.tag || 'all';
      const searchText = searchInput?.value.trim().toLowerCase() || '';

      cards.forEach(card => {
        const cardTags = JSON.parse(card.dataset.tags || '[]');
        const cardTitle = card.querySelector('.news-card-title')?.textContent?.toLowerCase() || '';
        const cardDesc = card.querySelector('.news-card-desc')?.textContent?.toLowerCase() || '';

        const matchTag = selectedTag === 'all' || cardTags.includes(selectedTag);
        const matchSearch = !searchText || cardTitle.includes(searchText) || cardDesc.includes(searchText);

        card.style.display = (matchTag && matchSearch) ? 'flex' : 'none';
      });
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        filterCards();
      });
    });

    searchInput?.addEventListener('input', filterCards);
  </script>
</Model>