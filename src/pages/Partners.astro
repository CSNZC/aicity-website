---
import Model from '../layouts/Model.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

// 1. 取得所有夥伴資料，排除草稿
const allPartners: CollectionEntry<'partners'>[] = await getCollection('partners', ({ data }: CollectionEntry<'partners'>) => {
  return data.draft !== true; 
});

// 2. 排序邏輯（數字越小越前面）
allPartners.sort((a, b) => a.data.weight - b.data.weight);

// 3. 分成外聘、企業與公協會
const lecturers = allPartners.filter(p => p.data.category === 'lecturer');
const enterprisePartners = allPartners.filter(p => p.data.category === 'enterprise');
const associationPartners = allPartners.filter(p => p.data.category === 'association');
---

<Model title="團隊介紹 | 艾城市有限公司" customCss="/css/Partners.css">
  <main class="page-content">
    <section class="page-header-section">
      <div class="container">
        <h1 class="page-title">專業團隊與合作夥伴</h1>
        <p class="page-subtitle">匯聚永續發展、ESG 規劃、碳盤查與數位轉型的頂尖專家，攜手共創綠色未來</p>
      </div>
    </section>

    <!-- 組織架構圖 -->
    <section class="org-chart-section">
      <div class="container">
        <div class="section-title-wrapper">
          <span class="section-badge">Organization</span>
          <h2 class="section-title">團隊組織架構</h2>
        </div>
        <div class="org-chart-container">
          <img src="/img/team.jpg" alt="艾城市組織架構圖" class="org-chart-img">
        </div>
      </div>
    </section>

    <!-- 公司職員 -->
    <section class="team-section">
      <div class="container">
        <div class="section-title-wrapper">
          <span class="section-badge">Team</span>
          <h2 class="section-title">公司職員</h2>
          <p class="section-desc">秉持專業與熱忱，為企業提供全方位的永續顧問與專案管理服務</p>
        </div>
        <div class="team-grid">
          <!-- 執行長 -->
          <div class="team-card">
            <div class="team-img-wrapper">
              <img src="/img/team-1.png" alt="執行長" class="team-img">
            </div>
            <div class="team-info">
              <h3 class="team-name">劉正興 <span class="team-title-tag">執行長 / 創辦人</span></h3>
              <p class="team-bio">具備能源效率改善、減碳策略規劃與企業碳管理輔導經驗，熟悉節能技術應用、減量效益分析與碳管理制度實務。</p>
              <div class="team-experience">
                <h4 class="exp-title">經歷：</h4>
                <ul>
                  <li>中華永續淨零推動協會｜理事長</li>
                  <li>艾城市有限公司｜執行長</li>
                  <li>銘傳大學｜兼任講師</li>
                  <li>iPAS淨零碳規劃管理師培訓｜講師</li>
                  <li>經濟部產業發展署淨零人才培訓｜講師</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- 協理-陳 -->
          <div class="team-card">
            <div class="team-img-wrapper">
              <img src="/img/team-2.png" alt="協理" class="team-img">
            </div>
            <div class="team-info">
              <h3 class="team-name">陳 晧 <span class="team-title-tag">策略長</span></h3>
              <p class="team-bio">具備企業 ESG 推動、永續揭露與碳盤查輔導經驗，熟悉 GHG Protocol、ISO 14064-1 與企業價值鏈盤查架構。</p>
              <div class="team-experience">
                <h4 class="exp-title">經歷：</h4>
                <ul>
                  <li>中華永續淨零推動協會 ｜秘書長</li>
                  <li>艾城市有限公司｜策略長</li>
                  <li>銘傳大學｜兼任講師</li>
                  <li>iPAS淨零碳規劃管理師培訓｜講師</li>
                  <li>低碳動能股份有限公司｜溫室氣體盤查顧問</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- 協理-劉 -->
          <div class="team-card">
            <div class="team-img-wrapper">
              <img src="/img/team-3.png" alt="協理" class="team-img">
            </div>
            <div class="team-info">
              <h3 class="team-name">劉恒齊 <span class="team-title-tag">協理 / 溫室氣體盤查顧問</span></h3>
              <p class="team-bio">協理專精於企業溫室氣體盤查與永續報告書（ESG）編製，協助企業精準對接國際標準、落實綠色低碳轉型。</p>
              <div class="team-experience">
                <h4 class="exp-title">經歷：</h4>
                <ul>
                  <li>中華永續淨零推動協會｜協理</li>
                  <li>iPAS 課程講師</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- 協理-林 -->
          <div class="team-card">
            <div class="team-img-wrapper">
              <img src="/img/team-4.png" alt="協理" class="team-img">
            </div>
            <div class="team-info">
              <h3 class="team-name">林育安 <span class="team-title-tag">協理 / 教培講師</span></h3>
              <p class="team-bio">具備企業碳管理、永續揭露與淨零轉型輔導經驗，熟悉 ISO 14064-1、GHG Protocol 與企業永續治理架構。</p>
              <div class="team-experience">
                <h4 class="exp-title">經歷：</h4>
                <ul>
                  <li>社團法人中華永續淨零推動協會｜理事</li>
                  <li>秘鍊永續協作有限公司｜永續顧問</li>
                  <li>源昇整合方案股份有限公司｜盤查顧問</li>
                  <li>經濟部產業發展署淨零人才培訓｜講師</li>
                  <li>國際品質驗證股份有限公司｜主導查證員</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 外聘講師 -->
    <section class="team-section bg-alt">
      <div class="container">
        <div class="section-title-wrapper">
          <span class="section-badge">lecturer</span>
          <h2 class="section-title">外聘講師與特約輔導師</h2>
        </div>
        <!-- 橫向滑動容器 -->
        <div class="expert-scroll-container">
          <div class="expert-scroll-track">
            {lecturers.map((item) => {
              const { name, logo, bio, title } = item.data;

              return (
                <div class="team-card expert-card">
                  <div class="team-img-wrapper">
                    <img src={logo} alt={name} class="team-img" loading="lazy" />
                  </div>
                  <div class="team-info">
                    <h3 class="team-name">
                      {name}
                      {title && <span class="team-title-tag">{title}</span>}
                    </h3>
                    {bio && <p class="team-bio">{bio}</p>}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </section>

    <!-- 合作公協會夥伴 -->
    <section class="partners-section">
      <div class="container">
        <div class="section-title-wrapper">
          <span class="section-badge">Public Association Partners</span>
          <h2 class="section-title">公協會合作夥伴</h2>
        </div>

        <div class="partners-grid">
          {associationPartners.map((partner) => (
            <a href={partner.data.url || "#"} target="_blank" rel="noopener noreferrer" class="partner-card">
              <img src={partner.data.logo} alt={partner.data.name} class="partner-logo">
              <span class="partner-name">{partner.data.name}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 企業夥伴 -->
    <section class="partners-section">
      <div class="container">
        <div class="section-title-wrapper">
          <span class="section-badge">Business Partners</span>
          <h2 class="section-title">合作企業夥伴</h2>
        </div>

        <div class="partners-grid">
          {enterprisePartners.map((partner) => (
            <a href={partner.data.url || "#"} target="_blank" rel="noopener noreferrer" class="partner-card">
              <img src={partner.data.logo} alt={partner.data.name} class="partner-logo">
              <span class="partner-name">{partner.data.name}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</Model>