---
import { getCollection, type CollectionEntry } from 'astro:content';
import Model from '../layouts/Model.astro';

// 依照您的專案習慣，以 CollectionEntry 定義型別引入資料
const allLinks: CollectionEntry<'links'>[] = await getCollection(
  'links', 
  (item: CollectionEntry<'links'>) => !item.data.draft
);
// 依照 weight 排序（數字越小越前面）
allLinks.sort((a, b) => a.data.weight - b.data.weight);

// 定義分類對應清單（確保順序與您原本網頁的區塊完全一致）
const categories = [
  { value: "government", title: "政府資源" },
  { value: "policy", title: "政策" },
  { value: "friendly", title: "友善連結" },
  { value: "guidelines", title: "報告書編製指引及參考網站" },
  { value: "carbon", title: "碳盤查指引" },
  { value: "ipas", title: "iPAS 教材專區" }
];
---

<Model title="相關連結" customCss="/css/links.css">
    <main class="page-content links-page">
        <div class="container">
            <h1 class="page-title">相關連結</h1>
            <p class="page-subtitle">提供您企業永續轉型所需之重要資源與參考資訊。</p>

            <div class="links-grid">
                <!-- 動態迴圈產生每一個分類卡片 -->
                {categories.map((cat) => {
                    // 篩選出屬於這個分類的連結
                    const categoryLinks = allLinks.filter((item) => item.data.category === cat.value);
                    
                    return (
                        <section class="link-card">
                            <div class="card-header">
                                <h2>{cat.title}</h2>
                            </div>
                            <ul class="link-list">
                                {categoryLinks.length > 0 ? (
                                    categoryLinks.map((link) => (
                                        <li>
                                            <a href={link.data.url || "#"} target="_blank" rel="noopener noreferrer">
                                                {link.data.name}
                                            </a>
                                        </li>
                                    ))
                                ) : (
                                    <li style="color: #999; font-size: 0.9rem; list-style: none;">暫無連結</li>
                                )}
                            </ul>
                        </section>
                    );
                })}
            </div>
        </div>
    </main>
</Model>