---
import Model from '../layouts/Model.astro'; 
import { getCollection, type CollectionEntry } from 'astro:content';

// 1. 最新消息與跑馬燈資料
const allPosts: CollectionEntry<'news'>[] = await getCollection('news');
const tickerItems = allPosts
  .filter(post => post.data.is_ticker === true) 
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()) 
  .map(post => post.data.title); 

const latestNews = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// 2. 首頁輪播圖資料
const carouselSlides: CollectionEntry<'carousel'>[] = await getCollection('carousel');
const sortedSlides = carouselSlides.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
---

<Model title="艾城市有限公司" customCss="/css/index.css">
  <!-- 區塊輪播圖 -->
  <section id="home" class="hero-section">
    <div class="carousel-container">
      
      <!-- 輪播圖片軌道 -->
      <div class="carousel-track" id="carousel-track">
        {sortedSlides.map((slide, index) => (
          <div class={`carousel-slide ${index === 0 ? 'active' : ''}`}>
            {slide.data.link ? (
              <a href={slide.data.link}>
                <img src={slide.data.image} alt={slide.data.title} />
              </a>
            ) : (
              <img src={slide.data.image} alt={slide.data.title} />
            )}
          </div>
        ))}
      </div>

      <!-- 左右控制按鈕 -->
      <button class="carousel-btn prev-btn" id="prev-btn" aria-label="上一張">❮</button>
      <button class="carousel-btn next-btn" id="next-btn" aria-label="下一張">❯</button>

      <!-- 底部圓點指示器 -->
      <div class="carousel-dots" id="carousel-dots">
        {sortedSlides.map((_, index) => (
          <span class={`dot ${index === 0 ? 'active' : ''}`} data-slide={index}></span>
        ))}
      </div>
      
    </div>
  </section>

  <!-- 跑馬燈 -->
  {tickerItems.length > 0 && (
    <section class="ticker-section">
      <div class="ticker-badge">最新消息</div>
      <div class="ticker-wrapper">
        <div id="ticker-track" class="ticker-track">
          {tickerItems.map((title) => (
            <div class="ticker-item">
              <span>{title}</span>
            </div>
          ))}
          {/* 多於 1 筆時，複製第 1 筆到末尾 */}
          {tickerItems.length > 1 && (
            <div class="ticker-item">
              <span>{tickerItems[0]}</span>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- 企業痛點 -->
  <section class="content-section bg-light-gray pain-section">
    <div class="section-container">
      <div class="pain-split-grid">
        <div class="pain-left-header">
          <span class="section-subtitle">TRANSFORMATION CHALLENGES</span>
          <h2 class="section-title">您的企業是否面臨以下轉型挑戰？</h2>
          <p class="pain-lead-text">面對日益嚴格的法規要求與供應鏈審查，我們提供一站式專業輔導，協助您打破減碳與數位轉型的盲點。</p>
        </div>

        <div class="pain-right-list">
          <div class="pain-item-card">
            <div class="pain-card-header">
              <span class="pain-tag tag-amber">合規與供應鏈</span>
              <h3 class="pain-item-title">法規與品牌要求雙重壓力？</h3>
            </div>
            <p class="pain-item-desc">不知如何開始 ISO 14064-1 組織碳盤查與 ISO 14067 產品碳足跡計算，面臨國際品牌供應鏈抽查危機。</p>
          </div>

          <div class="pain-item-card">
            <div class="pain-card-header">
              <span class="pain-tag tag-blue">數據管理</span>
              <h3 class="pain-item-title">數據收集繁瑣低效？</h3>
            </div>
            <p class="pain-item-desc">跨部門 Excel 整理耗時易錯，缺乏自動化整合工具（如 EI Bot）與 AI 客服輔助串接。</p>
          </div>

          <div class="pain-item-card">
            <div class="pain-card-header">
              <span class="pain-tag tag-green">資金補助</span>
              <h3 class="pain-item-title">轉型資金與資源不足？</h3>
            </div>
            <p class="pain-item-desc">想引進低碳與智慧化設備，卻不熟悉政府升級轉型補助（16+4 / 19+1）之申請與企劃流程。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 服務項目 -->
  <section id="services" class="content-section">
    <div class="section-container">
      <div class="section-header text-center">
        <span class="section-subtitle">OUR CORE SERVICES</span>
        <h2 class="section-title">艾城市核心服務項目</h2>
      </div>

      <div class="services-staggered-list">
        <div class="service-row-card step-1">
          <div class="service-num-badge">01</div>
          <div class="service-content">
            <h3 class="service-title">永續轉型服務</h3>
            <p> 溫室氣體盤查 | 碳足跡計算 | 永續報告書 | ESG永續轉型 | AI轉型輔導 </p>
          </div>
          <div class="service-arrow">
            <a href="/Service">
              <img src="/img/arrow-right.png" alt="arrow">
            </a>
          </div>
        </div>

        <div class="service-row-card step-2">
          <div class="service-num-badge gold-badge">02</div>
          <div class="service-content">
            <h3 class="service-title">人員培訓課程</h3>
            <p> iPAS 淨零碳規劃管理師培訓 | 國際認證 ISO 證照課程 | 永續相關課程 </p>
          </div>
          <div class="service-arrow">
            <a href="/Training">
              <img src="/img/arrow-right.png" alt="arrow">
            </a>
          </div>
        </div>

        <div class="service-row-card step-3">
          <div class="service-num-badge blue-badge">03</div>
          <div class="service-content">
            <h3 class="service-title">綠能光電建置</h3>
            <p> 場域規劃設計 | 工程承攬 | 運營維護服務 </p>
          </div>
          <div class="service-arrow">
            <a href="/Solar energy">
              <img src="/img/arrow-right.png" alt="arrow">
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 公司實績 -->
  <section id="cases" class="content-section bg-light-gray">
    <div class="section-container">
      <div class="section-header text-center">
        <span class="section-subtitle">Performance & Results</span>
        <h2 class="section-title">公司實績與輔導成果</h2>
      </div>
      <div class="stats-boxes-grid">
        <div class="stat-box-card">
          <div class="stat-number text-emerald">100+</div>
          <div class="stat-title">永續輔導實績</div>
          <p class="stat-desc">協助各類場域完成能源資產盤點與減碳路徑規劃</p>
        </div>
        <div class="stat-box-card">
          <div class="stat-number text-amber">500+</div>
          <div class="stat-title">培訓學員人次</div>
          <p class="stat-desc">舉辦iPAS淨零碳規劃管理師等課程，培育企業核心人才</p>
        </div>
        <div class="stat-box-card">
          <div class="stat-number text-blue">50+</div>
          <div class="stat-title">光電建置場域</div>
          <p class="stat-desc">提供太陽能規劃及工程建置，協助辦理再生能源憑證</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 最新消息 -->
  <section id="news" class="content-section">
    <div class="section-container">
      <div class="section-header flex-header">
        <div>
          <span class="section-subtitle">LATEST ANNOUNCEMENTS</span>
          <h2 class="section-title">最新消息與熱門課程</h2>
        </div>
        <a href="/News" class="btn-more-info">更多資訊 ➔</a>
      </div>
      <div class="news-grid-6">
        {latestNews.map((news) => (
          <article class="news-card">
            <div class="news-card-meta">
              <span class="news-tag tag-green">{news.data.tags[0] || '最新消息'}</span>
              <span class="news-date">
                {(() => {
                  const d = new Date(news.data.date);
                  return `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, '0')}/${String(d.getDate()).padStart(2, '0')}`;
                })()}
              </span>
            </div>
            <h3 class="news-card-title">
              <a href={`/News/${news.id}`}>{news.data.title}</a>
            </h3>
            <p class="news-card-summary">{news.data.summary}</p>
          </article>
        ))}
      </div>
      <div class="text-center mobile-more-btn-wrap">
        <a href="/News" class="btn-more-info">更多資訊 ➔</a>
      </div>
    </div>
  </section>

  <!-- 聯絡表單 -->
  <section id="contact" class="consult-section">
    <div class="consult-container">
      <div class="section-header text-center">
        <h2 class="consult-title">立即與我們連絡</h2>
        <p class="consult-subtitle">填寫下方資訊，艾城市專業顧問團隊將於 24 小時內與您聯繫</p>
      </div>

      <form id="consultForm" class="consult-form-card">
        <!-- 標記表單來源 -->
        <input type="hidden" name="formType" value="首頁嵌入-立即與我們連絡" />

        <div class="form-row-2">
          <div class="form-group">
            <label class="form-label">姓名 *</label>
            <input type="text" name="name" required class="form-input" placeholder="請輸入姓名" />
          </div>
          <div class="form-group">
            <label class="form-label">公司名稱 *</label>
            <input type="text" name="company" required class="form-input" placeholder="請輸入公司名稱" />
          </div>
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label class="form-label">聯絡電話 *</label>
            <input type="tel" name="phone" required class="form-input" placeholder="0912-345-678" />
          </div>
          <div class="form-group">
            <label class="form-label">電子郵件 *</label>
            <input type="email" name="email" required class="form-input" placeholder="service@company.com" />
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">諮詢需求領域 (可多選)</label>
          <div class="checkbox-options-grid">
            <label class="checkbox-option">
              <input type="checkbox" name="services" value="永續轉型" />
              <span>永續轉型</span>
            </label>
            <label class="checkbox-option">
              <input type="checkbox" name="services" value="人員培訓" />
              <span>人員培訓</span>
            </label>
            <label class="checkbox-option">
              <input type="checkbox" name="services" value="光電建置" />
              <span>光電建置</span>
            </label>
          </div>
          <div class="other-input-wrap">
            <label class="checkbox-option other-label">
              <input type="checkbox" id="otherCheckbox" name="services" value="其他" />
              <span>其他：</span>
            </label>
            <input type="text" name="otherDetail" id="otherDetail" class="form-input other-text-input" placeholder="請簡述您的其他特殊需求..." />
          </div>
        </div>
        
        <button type="submit" id="submitBtn" class="btn-submit-form">送出</button>
      </form>
    </div>
  </section>

  <!-- 首頁專屬腳本與跑馬燈變數傳遞 -->
  <script src="/js/index.js" defer></script>
  <script is:inline define:vars={{ tickerItems }}>
    window.TICKER_ITEMS = tickerItems;
  </script>
  <script>
    const GAS_ENDPOINT_URL = 'https://script.google.com/macros/s/AKfycbxMOq8iVJzfE8Yv3i1IBxGurpPZQqIxN5mH7-iKWRr6urXesAXgFPsiUbTTSo8qiBLS/exec';

    const form = document.getElementById('consultForm') as HTMLFormElement | null;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;

    if (form && submitBtn) {
      form.addEventListener('submit', async (e: SubmitEvent) => {
        e.preventDefault();

        // 1. 整理勾選的服務項目 (指定 string[] 避免 TS 報錯)
        const selectedServices: string[] = [];
        const checkboxes = form.querySelectorAll<HTMLInputElement>('input[name="services"]:checked');
        const otherDetailInput = document.getElementById('otherDetail') as HTMLInputElement | null;

        checkboxes.forEach((cb: HTMLInputElement) => {
          if (cb.value === '其他') {
            const detail = otherDetailInput ? otherDetailInput.value.trim() : '';
            selectedServices.push(detail ? `其他: ${detail}` : '其他');
          } else {
            selectedServices.push(cb.value);
          }
        });

        const getInputValue = (name: string): string => {
          const input = form.querySelector<HTMLInputElement>(`input[name="${name}"]`);
          return input ? input.value.trim() : '';
        };

        // 2. 打包資料
        const payload = {
          formType: getInputValue('formType'),
          name: getInputValue('name'),
          company: getInputValue('company'),
          phone: getInputValue('phone'),
          email: getInputValue('email'),
          services: selectedServices.join('、')
        };

        // 3. 切換按鈕狀態並送出
        submitBtn.disabled = true;
        const originalBtnText = submitBtn.textContent || '送出';
        submitBtn.textContent = '資料送出中...';

        try {
          await fetch(GAS_ENDPOINT_URL, {
            method: 'POST',
            mode: 'no-cors',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
          });

          alert('表單送出成功！艾城市專業顧問團隊將儘快與您聯繫。');
          form.reset();
        } catch (error) {
          console.error('送出失敗:', error);
          alert('送出時發生錯誤，請稍後再試或直接與我們聯絡。');
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = originalBtnText;
        }
      });
    }
  </script>
</Model>