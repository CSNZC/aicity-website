---
import {
  getCollection,
  render,
  type CollectionEntry
} from 'astro:content';

interface Props {
  category: 'iPAS' | 'ISO' | 'courses';
}

const { category } = Astro.props;

// 抓取 allcourses Collection
const allCourses: CollectionEntry<'allcourses'>[] =
  await getCollection('allcourses');

// 篩選、排序
const courses = allCourses
  .filter((course) => {
    // 隱藏的課程不顯示
    if (course.data.hide) return false;

    // 比對分類
    const courseCat = (course.data?.category || '').trim().toLowerCase();
    const targetCat = (category || '').trim().toLowerCase();

    return courseCat === targetCat;
  })
  .sort((a, b) => {
    const timeA = new Date(a.data.start_date).getTime();
    const timeB = new Date(b.data.start_date).getTime();

    // 越晚的課程排前面
    return timeB - timeA;
  });

// Render Markdown 正文
const renderedCourses = await Promise.all(
  courses.map(async (course) => {
    const { Content } = await render(course);

    return {
      ...course,
      Content,
    };
  })
);
---

<section class="course-catalog">
  {renderedCourses.map((course) => {
    const Content = course.Content;

    return (
      <details
        class="course-accordion-item"
        name="course-accordion"
      >
        <summary class="course-item-card">
          <div class="course-info">
            <h2>{course.data.name}</h2>

            <p class="course-meta">
              <strong>開課日期：</strong>
              {course.data.date_time}
            </p>

            <p class="course-meta">
              <strong>授課地點：</strong>
              {course.data.location}
            </p>

            {course.data.info && (
              <p class="course-desc">
                {course.data.info}
              </p>
            )}

            <span class="expand-hint">
              點擊查看課程與講師詳細資訊 ▼
            </span>
          </div>

          <div class="course-action">
            {course.data.registration_status === 'closed' ? (
              <span class="btn-primary-cta disabled">
                報名已截止
              </span>
            ) : course.data.registration_status === 'upcoming' ? (
              <span class="btn-primary-cta disabled">
                即將開放
              </span>
            ) : course.data.url ? (
              <a
                href={course.data.url}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary-cta"
                onclick="event.stopPropagation()"
              >
                立即報名
              </a>
            ) : (
              <span class="btn-primary-cta disabled">
                即將開放
              </span>
            )}
          </div>
        </summary>

        <div class="course-detail-panel">
          <div class="markdown-content">
            <Content />
          </div>
        </div>
      </details>
    );
  })}

  {renderedCourses.length === 0 && (
    <p class="no-courses">
      目前暫無開課資訊，敬請期待。
    </p>
  )}
</section>