  <!-- 頁面主要內容區塊 (各子頁面可在此填入不同內容) -->
<main class="page-content">
        <!-- 頁面標題與辦課證明/介紹 -->
        <section class="training-hero">
            <h1 class="page-title">專業人員培訓中心</h1>
            <p class="page-subtitle">協助企業與個人對接國際標準、提升職場綠色競爭力</p>
            <div class="certification-intro">
                <h3>🏆 專業辦課認證與實績保證</h3>
                <p>本公司擁有政府合法立案與各大國際驗證機構認可之培訓資歷。累計已協助超過百家企業培育專業稽核員與ESG管理人才，授課師資皆具備 10 年以上實務輔導經驗，確保學員結業後即具備即戰力。</p>
            </div>
        </section>

        <!-- 三大子項目綜合導覽 -->
        <section class="sub-projects-section">
            <h2 class="section-heading">培訓課程三大領域</h2>
            <div class="projects-grid">
                <!-- ISO 子項目 -->
                <div class="project-card">
                    <h3>ISO 國際課程</h3>
                    <p>涵蓋 ISO 14001、ISO 50001、ISO 14064 等國際標準主導稽核員培訓。</p>
                    <a href="/ISO" class="btn-primary-cta">進入 ISO 課程列表</a>
                </div>
                <!-- iPAS 子項目 -->
                <div class="project-card">
                    <h3>iPAS 課程</h3>
                    <p>經濟部產業人才能力鑑定衝刺班，精準掌握綠色科技與智慧製造關鍵能力。</p>
                    <a href="/iPAS" class="btn-primary-cta">進入 iPAS 課程列表</a>
                </div>
                <!-- 永續課程 子項目 -->
                <div class="project-card">
                    <h3>永續課程</h3>
                    <p>聚焦 ESG 永續報告書編撰、碳足跡盤查與淨零碳排策略實戰演練。</p>
                    <a href="/Courses" class="btn-primary-cta">進入永續課程列表</a>
                </div>
            </div>
        </section>

        <!-- 開課注意事項 -->
        <section class="notice-container">
            <h3>📌 開課注意事項與報名說明</h3>
            <ul class="notice-list">
                <li><strong>報名流程：</strong>點選各子項目進入課程列表 → 選擇欲報名梯次 → 填寫線上表單 → 完成匯款即完成保留席次。</li>
                <li><strong>退費機制：</strong>開課日前 7 天取消者全額退費（需扣除行政手續費）；開課日前 3 天內恕不退費，但可替換受訓學員。</li>
                <li><strong>企業包班：</strong>若企業有內訓需求，歡迎點擊下方按鈕預約專人客製化規劃。</li>
            </ul>
