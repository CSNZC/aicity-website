---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Model from '../../layouts/Model.astro';

export async function getStaticPaths() {
  const projects: CollectionEntry<'government'>[] = await getCollection('government');
  return projects.map(project => ({
    params: { slug: project.id || (project as any).slug },
    props: { project },
  }));
}

const { project } = Astro.props as { project: CollectionEntry<'government'> };
const { Content } = await render(project);

const formatDate = (date: Date) => {
  const d = new Date(date);
  return `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, '0')}/${String(d.getDate()).padStart(2, '0')}`;
};
---

<Model title={`${project.data.title} | 艾城市有限公司`}>
  <main class="article-page">
    <div class="article-wrapper">
      
      <!-- 返回按鈕 -->
      <div class="back-nav">
        <a href="/Government" class="back-btn">← 返回政府專案列表</a>
      </div>

      <!-- 標題與標籤 -->
      <header class="article-header">
        <div class="article-tag-list">
          <span class="article-tag">{project.data.tag}</span>
        </div>
        <h1 class="article-title">{project.data.title}</h1>
      </header>

      <!-- 主圖 (維持正常大小、不被裁切) -->
      {project.data.image && (
        <div class="article-image-box">
          <img src={project.data.image} alt={project.data.title} class="article-featured-img" />
        </div>
      )}

      <!-- 發布時間 -->
      <time class="article-meta-time" datetime={new Date(project.data.date).toISOString()}>
        發布日期：{formatDate(project.data.date)}
      </time>

      <!-- Markdown 內文渲染 -->
      <article class="article-body-content">
        <Content />
      </article>

    </div>
  </main>
</Model>

<style>
  .article-page {
    background-color: transparent;
    min-height: calc(100vh - var(--nav-height));
    padding: 40px 20px 100px;
  }
  
  .article-wrapper {
    max-width: 960px;
    margin: 0 auto;
    background: transparent;
    border: none;
    box-shadow: none;
    padding: 0;
  }

  .back-nav { 
    margin-bottom: 24px; 
  }
  
  .back-btn { 
    display: inline-flex; 
    align-items: center; 
    gap: 6px; 
    color: var(--primary-green, #1b5e20); 
    font-weight: 600; 
    font-size: 1rem; 
    text-decoration: none; 
    transition: color 0.2s ease;
  }
  
  .back-btn:hover { 
    color: var(--accent-gold, #c5a059); 
  }

  .article-header { 
    margin-bottom: 24px; 
  }
  
  .article-tag { 
    background: var(--accent-gold-light, #fdf8eb); 
    color: var(--accent-gold, #c5a059); 
    font-size: 0.85rem; 
    font-weight: 600; 
    padding: 4px 12px; 
    border-radius: 20px; 
  }
  
  .article-title { 
    font-family: 'Noto Serif TC', serif; 
    font-size: 2.35rem; 
    font-weight: 700; 
    color: var(--primary-green, #1b5e20); 
    line-height: 1.35; 
    margin-top: 12px; 
  }

  /* 圖片容器：限制最大高度，讓照片呈現正常大小且不裁切 */
  .article-image-box { 
    width: 100%; 
    max-height: 360px; /* 限制圖片容器最高為 420px */
    border-radius: 12px; 
    overflow: hidden; 
    margin-bottom: 28px; 
    background-color: var(--bg-light-gray, #f8f9fa); 
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .article-featured-img { 
    width: auto; /* 寬度自動縮放 */
    max-width: 100%;
    height: auto; 
    max-height: 360px; /* 確保高度正常，不會過大 */
    object-fit: contain; /* 確保完整呈現、絕不裁切 */
    display: block; 
    margin: 0 auto;
  }

  .article-meta-time { 
    font-size: 0.95rem; 
    color: var(--text-muted, #757575); 
    margin-bottom: 32px; 
    padding-bottom: 16px; 
    border-bottom: 1px solid var(--border-color, #eaeaea); 
    display: block; 
  }

  .article-body-content { 
    font-size: 1.125rem; 
    line-height: 1.95; 
    color: var(--text-body, #333333); 
  }
  
  .article-body-content :global(p) { 
    margin-bottom: 1.6em; 
  }

  .article-body-content :global(h2),
  .article-body-content :global(h3) {
    color: var(--primary-green, #1b5e20);
    margin-top: 2.4em;
    margin-bottom: 0.8em;
    font-weight: 700;
    padding-bottom: 0.4em;
    border-bottom: 1px dashed var(--border-color, #eaeaea);
  }

  .article-body-content :global(ul),
  .article-body-content :global(ol) {
    margin-bottom: 1.6em;
    padding-left: 24px;
  }

  .article-body-content :global(li) {
    margin-bottom: 8px;
  }

  @media (max-width: 768px) {
    .article-page {
      padding: 24px 16px 60px;
    }
    .article-title {
      font-size: 1.7rem;
    }
    .article-image-box {
      max-height: 260px; /* 手機版自動縮小高度 */
    }
    .article-featured-img {
      max-height: 260px;
    }
  }
</style>